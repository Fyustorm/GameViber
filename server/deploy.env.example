# Copy to deploy.env (not committed) and fill in.
SSH_HOST=api.gameviber.fyustorm.ovh
SSH_USER=deploy
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519_gameviber_deploy

# Where the releases go on the server, and the port the server listens on,
# for the reverse proxy. After changing them: ./deploy.sh --setup.
DEPLOY_DIR=/opt/gameviber
SERVER_PORT=8080
# The address it listens on: empty, the Docker bridge's (docker0) when Docker
# runs (a reverse proxy in a container), else 127.0.0.1; for a reverse proxy
# on another machine, the server's address on the network they share. Never
# a public one.
SERVER_ADDRESS=
# The reverse proxy's address (or range), the only one whose forwarded client
# address is believed: required when the proxy is on another machine.
PROXY_ADDRESS=

# Who runs ./deploy.sh --setup on the server: root, or a user with sudo.
SETUP_USER=root
